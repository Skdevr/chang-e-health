# ==============================================================================
# Chang'e Health — Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env e preencha os valores reais em produção.
# Nunca faça commit do arquivo .env.
# ==============================================================================

# --- Servidor & Rede ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# --- Autenticação & Segurança ---
# Obrigatório quando NODE_ENV=production (o servidor recusa subir sem ele).
# Gere com: openssl rand -hex 32
ADMIN_TOKEN=

# Modo de simulação: mantenha false em produção.
DEMO_MODE=false

# Ações destrutivas/operacionais (reiniciar/remover container): false por padrão.
# Só habilita quando ALLOW_ACTIONS=true E ADMIN_TOKEN configurado.
ALLOW_ACTIONS=false

# --- Docker Engine ---
# Recomendado: proxy somente leitura (tecnativa/docker-socket-proxy).
DOCKER_HOST=tcp://docker-proxy:2375
# Fallback quando DOCKER_HOST estiver vazio:
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Persistência ---
DATA_DIR=./data

# --- Probe HTTPS & Proteção SSRF ---
PROBE_URL=https://chang-e.app/
# Lista separada por vírgulas de hosts HTTPS permitidos (opcional; por padrão usa o host de PROBE_URL)
PROBE_ALLOWED_HOSTS=chang-e.app
# Intervalo de sincronização em background no servidor (ms, mínimo 10000)
MONITOR_SYNC_INTERVAL_MS=30000

# --- Alertas: E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chang'e Health <alerts@chang-e.app>

# --- Alertas: Telegram Bot API ---
# TELEGRAM_CHAT_ID deve ser o ID numérico do chat/grupo (ex.: -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
